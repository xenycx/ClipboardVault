# Public address
DOMAIN=vault.example.com
PUBLIC_BASE_URL=https://vault.example.com

# Generate each secret independently, for example: openssl rand -hex 32
# VAULT_SECRET signs short-lived browser state (social sign-in). Changing it only
# interrupts sign-ins that are in progress.
VAULT_SECRET=replace-with-at-least-32-random-bytes
# SETUP_TOKEN claims the first administrator on /setup.
SETUP_TOKEN=replace-with-at-least-32-random-bytes

# Daily database snapshots kept in /data/backups (0 disables them).
BACKUP_KEEP=7

# OAuth credentials. Each provider is optional, but its ID and secret must be set together.
# Leave all pairs blank for local password-only testing. Production callbacks are:
# https://<domain>/api/auth/callback/google
# https://<domain>/api/auth/callback/github
# https://<domain>/api/auth/callback/discord
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Deployment-wide hard limit (10 GiB). Workspace admins can choose a lower value.
SERVER_MAX_UPLOAD_BYTES=10737418240
# The classic multipart endpoint remains capped at 100 MiB.
LEGACY_MAX_UPLOAD_BYTES=104857600
# Tus uploads use fixed 16 MiB requests and expire after seven idle days.
TUS_CHUNK_SIZE_BYTES=16777216
TUS_SESSION_TTL_SECONDS=604800
# Reject new/resumed uploads before the upload volume would fall below 20 GiB free.
UPLOAD_DISK_RESERVE_BYTES=21474836480
# Nginx request limits include a small allowance for protocol/form overhead.
NGINX_LEGACY_CLIENT_MAX_BODY_SIZE=101m
NGINX_TUS_CLIENT_MAX_BODY_SIZE=17m
RUST_LOG=clipboard_vault=info,tower_http=info
