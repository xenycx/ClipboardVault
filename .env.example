# Public address
DOMAIN=vault.example.com
PUBLIC_BASE_URL=https://vault.example.com

# PostgreSQL
POSTGRES_DB=clipboard_vault
POSTGRES_USER=vault
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate each secret independently. See README.md.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_BRIDGE_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_TOKEN=replace-with-at-least-32-random-bytes

# Google Cloud OAuth Web Application credentials.
# Leave blank for local password-only testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deployment-wide hard upload limit. Workspace admins can choose a lower value.
SERVER_MAX_UPLOAD_BYTES=104857600
# Slightly above the file limit to leave room for multipart form headers.
NGINX_CLIENT_MAX_BODY_SIZE=101m
RUST_LOG=clipboard_vault=info,tower_http=info
